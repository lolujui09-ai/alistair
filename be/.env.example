# ====================================================================
# A L I S T A I R   -   B A C K E N D   E N V I R O N M E N T
# ====================================================================

PORT=3000

# --------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TiDB Cloud / MySQL)
# --------------------------------------------------------------------

# OPSI A (Rekomendasi TiDB Cloud): Menggunakan Connection String Link / URL
# Salin langsung connection string dari dashboard TiDB Cloud console
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl={"rejectUnauthorized":true}
TIDB_DATABASE_URL="mysql://xxxxxx.root:your_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/alistair?ssl={"rejectUnauthorized":true}"

# OPSI B: Menggunakan Parameter Individual
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxx.root
# DB_PASSWORD=your_password
# DB_NAME=alistair
# DB_SSL=true

# (Kredensial MySQL Lokal - Digunakan saat menjalankan skrip migrasi data dari lokal ke TiDB)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=root
LOCAL_DB_NAME=alistair

# --------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# --------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# --------------------------------------------------------------------
# 3. VECTOR DATABASE (QDRANT)
# --------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --------------------------------------------------------------------
# 4. CLOUDFLARE WORKERS AI (LLM ALISTAIR)
# --------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

